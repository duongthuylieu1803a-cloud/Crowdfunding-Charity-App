<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F0FF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header dùng chung hiển thị Hello + Tên Admin và Avatar đổi ảnh -->
        <include
            android:id="@+id/adminHeader"
            layout="@layout/layout_user_header" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Khối Thống kê Tổng Quỹ Ủng Hộ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tổng tiền đóng góp của toàn hệ thống"
                        android:textColor="#7B1FA2"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvTotalDonations"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="0 VNĐ"
                        android:textColor="#4A148C"
                        android:textSize="26sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="⚡ Danh Sách Chức Năng Quản Trị"
                android:textColor="#4A148C"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Chức năng 1: Tạo Chiến Dịch Mới -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCreateCampaignMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="➕ Tạo Chiến Dịch Gây Quỹ Mới"
                        android:textColor="#4A148C"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <!-- Phần chi tiết tạo chiến dịch (Mặc định ẩn) -->
                    <LinearLayout
                        android:id="@+id/layoutCreateCampaignDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <EditText
                            android:id="@+id/etCampaignTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:hint="Tên chiến dịch"
                            android:textSize="14sp" />

                        <ImageView
                            android:id="@+id/ivCampaignImagePreview"
                            android:layout_width="match_parent"
                            android:layout_height="180dp"
                            android:layout_marginBottom="8dp"
                            android:scaleType="centerCrop"
                            android:background="#E1BEE7"
                            android:src="@android:drawable/ic_menu_gallery"
                            android:contentDescription="Ảnh chiến dịch" />

                        <Button
                            android:id="@+id/btnSelectCampaignImage"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:text="📷 Chọn ảnh chiến dịch"
                            android:textColor="#7B1FA2" />

                        <EditText
                            android:id="@+id/etTargetAmount"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:hint="Số tiền mục tiêu (VNĐ)"
                            android:inputType="numberDecimal"
                            android:textSize="14sp" />

                        <EditText
                            android:id="@+id/etDescription"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:hint="Mô tả chiến dịch"
                            android:textSize="14sp" />

                        <Button
                            android:id="@+id/btnSubmitCreateCampaign"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:backgroundTint="#7B1FA2"
                            android:text="Phát Hành Chiến Dịch"
                            android:textColor="#FFFFFF" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Chức năng 2: Gửi Thông Báo Chung -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardBroadcastMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="📢 Gửi Thông Báo Chung Cho Mọi Người"
                        android:textColor="#4A148C"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <!-- Phần chi tiết thông báo (Mặc định ẩn) -->
                    <LinearLayout
                        android:id="@+id/layoutBroadcastDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <EditText
                            android:id="@+id/etBroadcastTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:hint="Tiêu đề thông báo"
                            android:textSize="14sp" />

                        <EditText
                            android:id="@+id/etBroadcastMessage"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:hint="Nội dung thông báo phát ra toàn hệ thống..."
                            android:textSize="14sp" />

                        <Button
                            android:id="@+id/btnSubmitBroadcast"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:backgroundTint="#8E24AA"
                            android:text="Phát Thông Báo"
                            android:textColor="#FFFFFF" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Chức năng 3: Quản Lý / Ẩn Hiện Chiến Dịch (MỚI BỔ SUNG) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardManageCampaignsMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="⚙️ Quản Lý / Đóng Mở Chiến Dịch"
                        android:textColor="#4A148C"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <!-- RecyclerView hiển thị danh sách chiến dịch để Admin bấm khóa/mở -->
                    <LinearLayout
                        android:id="@+id/layoutManageCampaignsDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:text="Chạm vào chiến dịch để thay đổi trạng thái hoạt động:"
                            android:textColor="#666666"
                            android:textSize="12sp" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvAdminManageCampaigns"
                            android:layout_width="match_parent"
                            android:layout_height="220dp"
                            android:clipToPadding="false" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Chức năng 4: Xem Danh Sách & Mức Độ Đóng Góp Của User -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDonatorsMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="👥 Danh Sách &amp; Mức Độ Đóng Góp Của User"
                        android:textColor="#4A148C"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <!-- Phần chi tiết danh sách người đóng góp (Mặc định ẩn) -->
                    <LinearLayout
                        android:id="@+id/layoutDonatorsDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvAdminDonations"
                            android:layout_width="match_parent"
                            android:layout_height="260dp"
                            android:clipToPadding="false"
                            android:scrollbars="vertical" />

                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- Nút Đăng Xuất Tài Khoản Admin -->
        <Button
            android:id="@+id/btnLogoutAdmin"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:text="🚪 Đăng Xuất Tài Khoản"
            android:textColor="#C62828"
            app:strokeColor="#C62828" />
        <!-- Nút test nhanh giao diện User không cần đăng xuất -->
        <Button
            android:id="@+id/btnQuickTestUser"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:text="🧪 Test nhanh giao diện User (Không cần Logout)"
            android:textColor="#7B1FA2"
            app:strokeColor="#7B1FA2" />
    </LinearLayout>
</ScrollView>