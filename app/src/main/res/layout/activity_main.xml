<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F5F0FF"
    tools:context=".MainActivity">

    <!-- 1. Header dùng chung hiển thị Hello + Tên user và Avatar -->
    <include
        android:id="@+id/userHeader"
        layout="@layout/layout_user_header" />

    <!-- 2. Nút mở Trang Quản Trị Admin (Mặc định ẩn, chỉ hiện khi user có role admin) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAdminDashboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        android:backgroundTint="#7B1FA2"
        android:text="⚡ Vào Trang Quản Trị Admin"
        android:textColor="#FFFFFF"
        android:visibility="gone"
        app:cornerRadius="10dp" />

    <!-- 3. Nút mở Hộp thư thông báo từ Admin (Đặt nổi bật bên trên) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnInbox"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="📥 Hộp Thư Thông Báo Từ Admin"
        android:textColor="#7B1FA2"
        app:cornerRadius="10dp"
        app:strokeColor="#7B1FA2" />

    <!-- Khối tuỳ chọn phụ: Thông tin & Đăng xuất thu gọn nhỏ phía trên danh sách -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🔥 Danh Sách Chiến Dịch"
            android:textColor="#4A148C"
            android:textSize="17sp"
            android:textStyle="bold" />


    </LinearLayout>

    <!-- 4. RecyclerView hiển thị danh sách chiến dịch chiếm toàn bộ không gian còn lại -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCampaigns"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false" />

</LinearLayout>