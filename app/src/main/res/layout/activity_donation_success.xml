<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#FFFFFF">

    <!-- Biểu tượng thành công với sắc tím -->
    <ImageView
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:src="@android:drawable/ic_menu_send"
        app:tint="#7B1FA2"
        android:layout_marginBottom="24dp" />

    <!-- Tiêu đề thông báo -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Thanh Toán Thành Công!"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#4A148C"
        android:layout_marginBottom="12dp" />

    <!-- Mô tả phụ -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cảm ơn bạn đã đóng góp cho chiến dịch từ thiện."
        android:textSize="14sp"
        android:textColor="#666666"
        android:gravity="center"
        android:layout_marginBottom="32dp" />

    <!-- Khung hiển thị chi tiết giao dịch (Nền tím nhạt) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#F3E5F5"
        android:padding="16dp"
        android:layout_marginBottom="32dp">

        <TextView
            android:id="@+id/tvSuccessCampaign"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Chiến dịch: ..."
            android:textSize="14sp"
            android:textColor="#333333"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvSuccessAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Số tiền: 0 đ"
            android:textSize="14sp"
            android:textColor="#333333"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvSuccessTransactionId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mã giao dịch: ..."
            android:textSize="14sp"
            android:textColor="#333333" />
    </LinearLayout>

    <!-- Nút bấm về trang chủ màu tím -->
    <Button
        android:id="@+id/btnBackToHome"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Về Trang Chủ"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="#7B1FA2" />

</LinearLayout>